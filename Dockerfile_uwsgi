FROM python:3.11.13-bookworm

# Metadata
LABEL Name="SynAnno" Version="1.0.0"

# Set working directory
WORKDIR /app

# Pin pip to the version in the previous deployed image
RUN python -m pip install --no-cache-dir pip==25.2

# Install system dependencies for PyQt5
RUN apt-get update && apt-get install -y \
    qtbase5-dev \
    qtchooser \
    qt5-qmake \
    qttools5-dev-tools \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Verify Cargo version
RUN cargo --version

# Copy application code
COPY setup.py requirements.lock /app/
COPY synanno /app/synanno
COPY run_production.py /app/
COPY h01/h01_104_materialization.csv /app/h01/h01_104_materialization.csv

# Install the locked Python dependencies, then the app. torch/torchvision come only
# from the CPU-only PyTorch index; everything else comes only from PyPI.
RUN grep -E '^(torch|torchvision)==' requirements.lock > /tmp/torch.lock \
    && grep -vE '^(torch|torchvision)==' requirements.lock > /tmp/pypi.lock \
    && python -m pip install --no-cache-dir --no-deps -r /tmp/torch.lock \
        --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install --no-cache-dir --no-deps -r /tmp/pypi.lock \
    && rm /tmp/torch.lock /tmp/pypi.lock
RUN python -m pip install --no-cache-dir --no-deps -e .

# Copy uWSGI configuration
COPY uwsgi.ini /app

# Expose Flask (port 80) and Neuroglancer (port 9015)
EXPOSE 80 9015

# Environment Variables
ENV DEBUG_APP="False"
ENV APP_IP="0.0.0.0"
ENV NG_IP="0.0.0.0"
ENV NG_PORT="9015"
ENV APP_PORT="80"
ENV EXECUTION_ENV="docker"

# Start Flask (via uWSGI) and Neuroglancer
CMD ["uwsgi", "--ini", "/app/uwsgi.ini", "--master", "--die-on-term"]
